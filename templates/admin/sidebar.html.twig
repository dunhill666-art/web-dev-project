<!-- UNIFIED SYMFONY ADMIN SIDEBAR -->
<aside class="sidebar">
  <a href="{{ ag_base_url('index.php') }}" class="sidebar-brand" style="text-decoration:none;color:inherit;" title="Return to Homepage">
    <img src="{{ asset_find(['logo']) }}" alt="Logo">
    <div>
      <span class="brand-text">AeroGlide</span>
      <span class="brand-badge" {% if admin.role == 'staff' %}style="background:linear-gradient(135deg,#0284c7,#0369a1);"{% endif %}>
        {{ admin.role == 'staff' ? 'STAFF' : 'ADMIN' }}
      </span>
    </div>
  </a>

  <nav class="sidebar-nav">
    <div class="nav-section-label">Operations</div>
    {% if admin.role != 'staff' %}
    <a href="{{ ag_base_url('admin') }}" class="nav-link {% if current_page == 'index.php' or current_page == 'dashboard' or current_page == 'admin' %}active{% endif %}">
      <span class="nav-icon">📊</span> Dashboard
    </a>
    {% endif %}
    <a href="{{ ag_base_url('admin/bookings.php') }}" class="nav-link {% if current_page == 'bookings.php' %}active{% endif %}">
      <span class="nav-icon">🎫</span> All Bookings
    </a>
    {% if admin.role != 'staff' %}
    <a href="{{ ag_base_url('admin/users.php') }}" class="nav-link {% if current_page == 'users.php' %}active{% endif %}">
      <span class="nav-icon">👥</span> Users
    </a>

    <div class="nav-section-label" style="margin-top:.75rem;">Reports</div>
    <a href="{{ ag_base_url('admin/revenue.php') }}" class="nav-link {% if current_page == 'revenue.php' %}active{% endif %}">
      <span class="nav-icon">💰</span> Revenue
    </a>
    <a href="{{ ag_base_url('admin/logs.php') }}" class="nav-link {% if current_page == 'logs.php' %}active{% endif %}">
      <span class="nav-icon">📋</span> Activity Logs
    </a>
    {% endif %}

    <div class="nav-section-label" style="margin-top:.75rem;">Site</div>
    <a href="{{ ag_base_url('index.php') }}" class="nav-link" target="_blank">
      <span class="nav-icon">🌐</span> View Website
    </a>
  </nav>

  <div class="sidebar-footer">
    <div class="admin-info">
      <div class="admin-avatar" {% if admin.role == 'staff' %}style="background:#0284c7;"{% endif %}>{{ admin.name|slice(0, 1)|upper }}</div>
      <div>
        <div class="admin-name">{{ admin.name }}</div>
        <div class="admin-role">{{ admin.role == 'staff' ? 'Staff Member' : 'Administrator' }}</div>
      </div>
    </div>
    <a href="{{ ag_base_url('user/logout.php') }}" class="nav-link" style="padding:0;color:var(--muted);font-size:.78rem;" title="Sign out">Sign Out</a>
  </div>
</aside>
