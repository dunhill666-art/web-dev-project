### --- AeroGlide Environment Config ---
APP_ENV=dev
APP_SECRET=4f8b2c1e7a903d6521e84c9f1a2b3c4d
DEFAULT_URI=http://localhost:8080

### --- Reverse Proxy & Ngrok Public Tunneling ---
# Automatically trusts Ngrok reverse proxy headers (X-Forwarded-Proto, X-Forwarded-Host)
# to ensure HTTPS links, secure redirects, and sessions work seamlessly across devices
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR,private_ranges
TRUSTED_HOSTS=^.*$

### --- Optional: Ngrok Token for Dockerized Tunnel ---
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

### --- Database Parameters (Containerized MariaDB / Host Fallback) ---
# When running with Docker Compose, DB_HOST=db and credentials are automatically injected.
# The values below allow local CLI tools or host scripts to connect via mapped port 3307.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=aeroglide
DB_USER=aeroglide
DB_PASSWORD=aeroglide_secret

### --- Symfony / Doctrine Connection URL ---
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=mariadb-10.11.0&charset=utf8mb4"

### --- Messenger & Mailer Transports ---
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
