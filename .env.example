### ------------------------------------------------------------
### OPTION B: Local WAMP / XAMPP Setup (Default fallback)
### ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aeroglide
DB_USER=root
DB_PASSWORD=
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=10.11-mariadb&charset=utf8mb4"

### Messenger & Mailer
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
