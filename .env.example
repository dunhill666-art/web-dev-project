### ============================================================
### AeroGlide Environment Configuration Template (.env.example)
### ============================================================

### Application Environment (dev | prod | test)
APP_ENV=dev
APP_SECRET=4f8b2c1e7a903d6521e84c9f1a2b3c4d
DEFAULT_URI=http://localhost:8080

### ------------------------------------------------------------
### Reverse Proxy & Ngrok Public Tunneling
### ------------------------------------------------------------
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR,private_ranges
TRUSTED_HOSTS=^.*$

### Optional: Ngrok Token for Dockerized Tunnel
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

### ------------------------------------------------------------
### OPTION A: Docker Setup (Automatically provided by docker-compose)
### ------------------------------------------------------------
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=aeroglide
# DB_USER=aeroglide
# DB_PASSWORD=aeroglide_secret
# DATABASE_URL="mysql://aeroglide:aeroglide_secret@db:3306/aeroglide?serverVersion=mariadb-10.11.0&charset=utf8mb4"

### ------------------------------------------------------------
### OPTION B: Host Connection to Docker MariaDB (Default)
### ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=aeroglide
DB_USER=aeroglide
DB_PASSWORD=aeroglide_secret
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=mariadb-10.11.0&charset=utf8mb4"

### ------------------------------------------------------------
### OPTION C: Legacy Local WAMP / XAMPP Setup
### ------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=aeroglide
# DB_USER=root
# DB_PASSWORD=
# DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=mariadb-10.11.0&charset=utf8mb4"

### Messenger & Mailer
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
