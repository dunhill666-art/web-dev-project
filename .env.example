DB_USER=root
DB_PASSWORD=

### Symfony / Doctrine Connection URL
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=10.11-mariadb&charset=utf8mb4"

