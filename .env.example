### Application Environment (dev | prod | test)
APP_ENV=dev
APP_SECRET=4f8b2c1e7a903d6521e84c9f1a2b3c4d
DEFAULT_URI=http://localhost

### ------------------------------------------------------------
### OPTION A: Docker Setup (Automatically provided by docker-compose)
### ------------------------------------------------------------
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=aeroglide
# DB_USER=aeroglide
# DB_PASSWORD=aeroglide_secret
