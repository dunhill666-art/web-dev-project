# AeroGlide Web Application Apache Configuration
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Security Headers
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "SAMEORIGIN"
        Header set X-XSS-Protection "1; mode=block"
    </IfModule>

    # Prevent direct directory browsing
    Options -Indexes

    # 1. Route Symfony Admin Panel virtual routes directly to Symfony Front Controller
    RewriteRule ^admin/?$ public/index.php [QSA,L]
    RewriteRule ^admin/index\.php$ public/index.php [QSA,L]
    RewriteRule ^admin/dashboard/?$ public/index.php [QSA,L]
    RewriteRule ^admin/api/(.*)$ public/index.php [QSA,L]

    # 2. If the requested file physically exists, serve it directly (e.g. admin/bookings.php, style.css, assets)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. If a directory exists (other than the admin dashboard itself), serve directly
    RewriteCond %{REQUEST_URI} !^/admin/?$
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Forward all other requests to the Symfony Front Controller
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>
