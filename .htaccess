# AeroGlide Web Application Apache Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Security Headers
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "SAMEORIGIN"
        Header set X-XSS-Protection "1; mode=block"
    </IfModule>

    # Prevent direct directory browsing
    Options -Indexes

    # If the requested file or directory physically exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Forward all other requests to the Symfony Front Controller
    RewriteRule ^ public/index.php [L]
</IfModule>
